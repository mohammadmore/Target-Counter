# Never serve the secrets file or backups of it, even if placed in the web root.
<FilesMatch "^kiyan-config.*\.php$|\.(bak|old|orig|swp)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Make sure PHP receives the Authorization header on Apache/CGI setups.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

Options -Indexes

# Build files have content hashes in their names: cache them for a year.
# index.html and api.php must always be fresh so new releases show up at once.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|webp|jpe?g|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html)?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
